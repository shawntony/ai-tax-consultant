      "previousGifts: array of {date, amount, taxPaid}",
      "relationship: 'spouse' | 'lineal_ascendant' | 'lineal_descendant' | 'other_relative' | 'non_relative'",
      "recipientAge: number (for lineal_ascendant distinction)"
    ],
    "outputFormat": {
      "totalGifts": "number (10년 합산)",
      "deductionAmount": "number (관계별 공제)",
      "taxBase": "number (과세표준)",
      "previousTaxPaid": "number (기납부세액)",
      "relationship": "string",
      "tenYearGifts": "array of gift objects",
      "availableDeduction": "number (남은 공제액)"
    },
