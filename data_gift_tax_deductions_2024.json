  "calculationFormula": {
    "general": "과세표준 = (현재증여액 + 10년내증여액) - 관계별공제",
    "detailedSteps": [
      "1. 증여일로부터 10년 이내 동일인 증여 조회",
      "2. 과거 증여액 + 현재 증여액 합산",
      "3. 증여자와 수증자 관계 확인",
      "4. 관계별 공제액 적용 (10년간 1회)",
      "5. 과세표준 = 합산 증여액 - 공제액",
      "6. 세율 적용 (상속세와 동일한 5단계 누진세율)",
      "7. 기납부 증여세액 차감",
      "8. 최종 납부세액 산출"
    ],
    "formula": {
      "taxBase": "max(totalGifts - deduction, 0)",
      "taxAmount": "taxBase × taxRate - progressiveDeduction",
      "netTaxDue": "taxAmount - previousTaxPaid"
    }
  },
  "usageGuidelines": {
    "implementationPath": "src/constants/deductions.js",
    "functionName": "calculateGiftDeductions(currentGift, previousGifts, relationship, recipientAge)",
    "inputValidation": [
