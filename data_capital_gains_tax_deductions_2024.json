  "calculationExample": {
    "scenario": "1세대1주택 10년 보유, 5년 거주",
    "transferPrice": 1000000000,
    "acquisitionPrice": 600000000,
    "necessaryExpenses": {
      "acquisitionCosts": 18000000,
      "improvementCosts": 20000000,
      "transferCosts": 5000000,
      "total": 43000000
    },
    "capitalGain": 357000000,
    "longTermDeduction": {
      "holdingYears": 10,
      "residenceYears": 5,
      "totalYears": 15,
      "deductionRate": 0.80,
      "deductionAmount": 285600000
    },
    "taxBase": 68900000,
    "basicDeduction": 2500000,
    "finalTaxBase": 66400000,
    "calculation": {
      "step1": "양도차익 = 양도가액(10억) - 취득가액(6억) - 필요경비(0.43억) = 3.57억",
      "step2": "장기보유특별공제 = 3.57억 × 80% = 2.856억",
      "step3": "과세표준 = 3.57억 - 2.856억 = 0.714억",
      "step4": "기본공제 = 0.714억 - 0.025억 = 0.689억",
      "step5": "세율 적용 (35% - 1,544만원)",
      "step6": "산출세액 = 0.689억 × 35% - 1,544만원 = 0.868억"
    }
  },
