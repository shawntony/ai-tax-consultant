  "calculationFormula": {
    "general": "양도소득세 = (양도차익 - 장기보유특별공제) × 세율 - 누진공제",
    "steps": [
      "1. 양도차익 계산 = 양도가액 - (취득가액 + 필요경비)",
      "2. 장기보유특별공제 계산 (3년 이상 보유 시)",
      "3. 과세표준 = 양도차익 - 장기보유특별공제 - 기본공제(250만원)",
      "4. 세율 적용 (8단계 누진세율 또는 중과세율)",
      "5. 산출세액 = 과세표준 × 세율 - 누진공제",
      "6. 지방소득세 = 산출세액 × 10%"
    ],
    "detailedCalculation": {
      "transferPrice": "양도가액 (실제 거래가격)",
      "acquisitionCost": "취득가액 + 취득세 + 복비 등",
      "necessaryExpenses": "자본적 지출, 양도비용 등",
      "capitalGain": "양도차익 = 양도가액 - (취득가액 + 필요경비)",
      "longTermDeduction": "장기보유특별공제 = 양도차익 × 공제율",
      "basicDeduction": "기본공제 250만원 (1년 1회)",
      "taxBase": "과세표준 = 양도차익 - 장기보유특별공제 - 기본공제",
      "taxAmount": "산출세액 = 과세표준 × 세율 - 누진공제",
      "localIncomeTax": "지방소득세 = 산출세액 × 10%",
      "totalTax": "총 납부세액 = 산출세액 + 지방소득세"
    }
  },
